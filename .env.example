# === Netlify Environment Variables ===
# Required for Stripe checkout (create-checkout.js, stripe-webhook.js)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_KEY
# Stripe publishable key (used client-side in ordering_system.html)
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_KEY

# Required for lead capture (netlify/functions/submit-lead.js)
LEAD_API_KEY=your-insforge-jwt-api-key
# Optional: custom Insforge endpoint
# LEAD_API_URL=https://custom.insforge.app/rest/v1/leads

# Site URL (used for Stripe success/cancel redirects)
URL=https://usstech.net

# === Local dev ===
# Uncomment for local Netlify dev:
# URL=http://localhost:8888
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
