---
import Page from '../../layouts/Page.astro';
---

<Page title="App Development - Ultimate Security Solutions" description="Download our mobile applications. PartSmart AI and Ultimate Security Suite.">
    <div class="container" style="text-align:center; padding:8rem 2rem 3rem;">
        <h1>APP <span class="text-accent">DEVELOPMENT</span></h1>
        <p style="color:var(--muted);">Our suite of professional mobile applications.</p>
    </div>

    <section class="section" style="padding-top:0;">
        <div class="container" style="max-width:1000px; display:grid; gap:3rem;">

            <div class="anim" style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:2.5rem; display:grid; grid-template-columns:1fr 2fr; gap:2rem; align-items:center;">
                <div style="text-align:center;">
                    <div style="background:linear-gradient(135deg, #0051BA, #003d8f); border-radius:16px; padding:2rem; display:inline-block;">
                        <i class="fas fa-hammer" style="font-size:3rem; color:#FFDB00;"></i>
                    </div>
                    <h3 style="color:#0051BA; margin-top:1rem;">PartSmart AI</h3>
                    <span style="display:inline-block; background:#FFDB00; color:#0051BA; font-size:0.75rem; font-weight:700; padding:0.25rem 0.75rem; border-radius:999px; margin-top:0.5rem;">BETA</span>
                </div>
                <div>
                    <h2 style="margin-bottom:0.5rem;">AI-Powered DIY Project Generator</h2>
                    <p style="color:var(--muted); line-height:1.7; margin-bottom:1rem;">
                        Transform scrap materials and spare parts into professional engineering projects. Photograph your parts, 
                        and Gemini AI identifies, catalogs, and designs complete build plans with 3D renders, exploded views, 
                        cut lists, and step-by-step assembly instructions.
                    </p>
                    <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1.5rem;">
                        <span style="background:rgba(0,81,186,0.1); color:#0051BA; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">AI Part Recognition</span>
                        <span style="background:rgba(0,81,186,0.1); color:#0051BA; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">3D Render Engine</span>
                        <span style="background:rgba(0,81,186,0.1); color:#0051BA; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">Step-by-Step Wizard</span>
                        <span style="background:rgba(0,81,186,0.1); color:#0051BA; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">Smart BOM Assistant</span>
                        <span style="background:rgba(0,81,186,0.1); color:#0051BA; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">Structural Audit</span>
                    </div>
                    <a href="/appdev/partsmart-tutorial" class="btn btn-primary" style="margin-right:0.5rem;"><i class="fas fa-book-open"></i> Tutorial</a>
                    <a href="/appdev/partsmart-download" class="btn" style="border:1px solid var(--border);"><i class="fas fa-download"></i> Download APK</a>
                </div>
            </div>

            <div class="anim" style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:2.5rem; display:grid; grid-template-columns:1fr 2fr; gap:2rem; align-items:center;">
                <div style="text-align:center;">
                    <div style="background:linear-gradient(135deg, #06b6d4, #020617); border-radius:16px; padding:2rem; display:inline-block;">
                        <i class="fas fa-shield-halved" style="font-size:3rem; color:#06b6d4;"></i>
                    </div>
                    <h3 style="color:var(--accent); margin-top:1rem;">USS Suite</h3>
                    <span style="display:inline-block; background:#06b6d4; color:#020617; font-size:0.75rem; font-weight:700; padding:0.25rem 0.75rem; border-radius:999px; margin-top:0.5rem;">BETA</span>
                </div>
                <div>
                    <h2 style="margin-bottom:0.5rem;">Ultimate Security Suite</h2>
                    <p style="color:var(--muted); line-height:1.7; margin-bottom:1rem;">
                        Professional security system design tool with satellite targeting, AI wireframe generation, 
                        device placement, cable routing, and instant quote generation. Built for integrators.
                    </p>
                    <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1.5rem;">
                        <span style="background:rgba(6,182,212,0.1); color:#06b6d4; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">Satellite Targeting</span>
                        <span style="background:rgba(6,182,212,0.1); color:#06b6d4; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">AI Wireframe</span>
                        <span style="background:rgba(6,182,212,0.1); color:#06b6d4; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">Cable Routing</span>
                        <span style="background:rgba(6,182,212,0.1); color:#06b6d4; font-size:0.75rem; padding:0.25rem 0.75rem; border-radius:999px;">Quote Engine</span>
                    </div>
                    <a href="https://uss-app.insforge.site" target="_blank" class="btn btn-primary" style="margin-right:0.5rem;"><i class="fas fa-globe"></i> Launch Web App</a>
                    <a href="#downloads" class="btn" style="border:1px solid var(--border);"><i class="fas fa-download"></i> Desktop Downloads</a>
                </div>
            </div>

            <div id="downloads" class="anim" style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:2.5rem;">
                <h2 style="margin-bottom:1rem;"><i class="fas fa-download" style="color:var(--accent);"></i> Desktop Downloads</h2>
                <p style="color:var(--muted); line-height:1.7; margin-bottom:2rem;">
                    Install Ultimate Security Suite as a native desktop application for the best experience, 
                    including Google sign-in for AI features. Or use the <a href="https://uss-app.insforge.site" target="_blank" style="color:var(--accent);">web version</a> with an API key.
                </p>
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:1.5rem;">
                    <a href="https://xr3keedn.us-east.insforge.app/api/storage/buckets/uss-downloads/objects/linux%2Fuss-suite_1.0.0_amd64.deb" class="btn" style="border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; gap:0.5rem; padding:1.5rem; text-decoration:none;">
                        <i class="fab fa-linux" style="font-size:2rem; color:var(--accent);"></i>
                        <strong>Linux (.deb)</strong>
                        <span style="font-size:0.75rem; color:var(--muted);">Ubuntu / Debian — 9 MB</span>
                    </a>
                    <a href="https://xr3keedn.us-east.insforge.app/api/storage/buckets/uss-downloads/objects/linux%2Fuss-suite_1.0.0_x86_64.rpm" class="btn" style="border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; gap:0.5rem; padding:1.5rem; text-decoration:none;">
                        <i class="fab fa-linux" style="font-size:2rem; color:var(--accent);"></i>
                        <strong>Linux (.rpm)</strong>
                        <span style="font-size:0.75rem; color:var(--muted);">Fedora / RHEL — 9 MB</span>
                    </a>
                    <div class="btn" style="border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; gap:0.5rem; padding:1.5rem; opacity:0.5; cursor:not-allowed;">
                        <i class="fab fa-windows" style="font-size:2rem; color:var(--muted);"></i>
                        <strong>Windows (.exe)</strong>
                        <span style="font-size:0.75rem; color:var(--muted);">Coming Soon</span>
                    </div>
                    <div class="btn" style="border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; gap:0.5rem; padding:1.5rem; opacity:0.5; cursor:not-allowed;">
                        <i class="fab fa-apple" style="font-size:2rem; color:var(--muted);"></i>
                        <strong>macOS (.dmg)</strong>
                        <span style="font-size:0.75rem; color:var(--muted);">Coming Soon</span>
                    </div>
                </div>
            </div>

        </div>
    </section>
</Page>
